{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DG_REPO",
    "NODE_ENV",
    "PLAYWRIGHT_CORE",
    "TRUSOMA_PYTHON",
    "TRUSOMA_READONLY",
    "TRUSOMA_ROOT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "outputs": []
    },
    "test:unit": {
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
