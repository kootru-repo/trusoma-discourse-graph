{
  "name": "trusoma-discourse-graph-demo",
  "version": "0.1.0",
  "private": true,
  "description": "The TruSoma discourse graph in TypeScript: a canvas, a query engine, an MCP server and a database load over the vault.",
  "scripts": {
    "build": "turbo build",
    "ci:validate": "turbo check-types && turbo run test:unit --ui stream",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo run test:unit --ui stream",
    "start": "pnpm --filter @repo/mcp start",
    "dev": "pnpm --filter @repo/canvas dev",
    "db:hosted": "pnpm --filter @repo/graph db:hosted",
    "check:upstream": "pnpm --filter @repo/graph check:upstream",
    "example": "pnpm --filter @repo/graph example",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,md,mdx}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@10.15.1",
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
