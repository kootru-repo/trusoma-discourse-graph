  "TARGET_NOTES": {
   "_why": "USER 2026-11-11: nothing in the body or the learner sets how often the fetus attempts a movement; in the fetus it is set by how excitable the spontaneous generators are at that age, so the rate is constrained by sourced counts at the generator, and contact is never fitted. Format of TARGET rows: [median at 12 weeks, median at 13 weeks, lowest fetus, highest fetus].",
   "gm_pct": {
    "role": "FIT",
    "constrains": "the common generator bias",
    "source": "de Vries, Visser and Prechtl 1985, Early Hum Dev 12:99-120, doi:10.1016/0378-3782(85)90174-4, scatter figures read into companion/sources/deVries1985_extract.md; median at 12 weeks, at 13 weeks, lowest and highest fetus over both (Fig. 2)"
   },
   "arm_h": {
    "role": "FIT",
    "constrains": "the per-joint generator bias; every arm movement outside a general movement counts, not only large ones",
    "source": "de Vries, Visser and Prechtl 1985, Early Hum Dev 12:99-120, doi:10.1016/0378-3782(85)90174-4, scatter figures read into companion/sources/deVries1985_extract.md; median at 12 weeks, at 13 weeks, lowest and highest fetus over both (Fig. 11)"
   },
